# Server Configuration
PORT=8080
GIN_MODE=release

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crowdfunding?sslmode=disable

# Blockchain (Polygon Amoy Testnet)
RPC_URL=https://rpc-amoy.polygon.technology/
FACTORY_ADDRESS=0x94B09c15E4E8f96D23883E1b24fD872EA6e06EF0
IMPLEMENTATION_ADDRESS=0x8C47384c12e563D2B19ff7bc7C205602A1c62Bf3
CHAIN_ID=80002

# Redis
REDIS_URL=redis://localhost:6379

# JWT (Use 256-bit secret in production)
JWT_SECRET=your-secret-key-change-in-production

# Admin wallet addresses (comma-separated)
ADMIN_ADDRESSES=0xYourAdminWallet1,0xYourAdminWallet2

# Private Key (for admin operations - NEVER commit this)
PRIVATE_KEY=

# Email (SMTP) - Optional
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@crowdfunding.com
SMTP_FROM_NAME=Crowdfunding Platform

# Storage Provider: "local", "s3"
STORAGE_PROVIDER=local
UPLOAD_PATH=./uploads

# S3 Configuration (if using S3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
