# Server Configuration
PORT=8080
GIN_MODE=release

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crowdfunding?sslmode=disable

# Blockchain — BSC Testnet (Campaigns + KGST)
BSC_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/
BSC_FACTORY_ADDRESS=
BSC_IMPL_ADDRESS=
BSC_KGST_ADDRESS=
BSC_CHAIN_ID=97

# Blockchain — Polygon Amoy (Governance)
POLYGON_RPC_URL=https://rpc-amoy.polygon.technology/
POLYGON_CHAIN_ID=80002
POLYGON_GOV_TOKEN=
POLYGON_DAO=
POLYGON_REGISTRY=

# Legacy compatibility keys (point these to BSC campaign contracts)
RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/
FACTORY_ADDRESS=
IMPLEMENTATION_ADDRESS=
CHAIN_ID=97

# Redis
REDIS_URL=redis://localhost:6379

# JWT (Use 256-bit secret in production)
JWT_SECRET=your-secret-key-change-in-production

# Admin wallet addresses (comma-separated)
ADMIN_ADDRESSES=0xYourAdminWallet1,0xYourAdminWallet2

# Private Key (for admin operations - NEVER commit this)
PRIVATE_KEY=

# Email (SMTP) - Optional
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@crowdfunding.com
SMTP_FROM_NAME=Crowdfunding Platform

# Storage Provider: "local", "s3"
STORAGE_PROVIDER=local
UPLOAD_PATH=./uploads

# S3 Configuration (if using S3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
